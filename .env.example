# Boomi Companion — environment template.
# Copy to `.env` (which is gitignored) and fill in your real keys.

# Deepgram streaming speech-to-text key (required).
DEEPGRAM_API_KEY=

# Groq LLM key (required — primary answer/fast-path provider).
GROQ_API_KEY=

# Groq Multi-Key Pooling (optional): a comma-separated list of additional
# free-tier Groq keys. ProviderRouter round-robins across every key so N
# accounts pool their rate-limit headroom. When set, GROQ_API_KEYS takes
# priority over GROQ_API_KEY.
# Example: GROQ_API_KEYS=gsk_keyOne12345,gsk_keyTwo67890,gsk_keyThreeABCDE
GROQ_API_KEYS=

# Gemini key (optional — legacy automatic failover provider).
GEMINI_API_KEY=

# OpenRouter key (optional — free-tier OpenAI-compatible failover provider,
# meta-llama free models). OPENROUTER_API_KEYS (comma-separated, pooled) takes
# priority over OPENROUTER_API_KEY.
# Example: OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=

# Cerebras key (optional — free-tier OpenAI-compatible failover provider,
# llama3.1 free models). CEREBRAS_API_KEYS (comma-separated, pooled) takes
# priority over CEREBRAS_API_KEY.
# Example: CEREBRAS_API_KEYS=cerebras-aaaaaaaa,cerebras-bbbbbbbb
CEREBRAS_API_KEY=
CEREBRAS_API_KEYS=

# Write a full JSONL session log to logs/ (true) or disable (false).
DEBUG_DIAGNOSTICS=true

# Pilot privacy: "debug" (default; logs full transcript content for developer
# analysis) or "pilot" (strips candidate transcript/content, keeps timing,
# provider, latency, fallback, and confidence metrics only).
DIAGNOSTICS_PRIVACY=debug