# Boomi Companion — environment template.
# Copy to `.env` (which is gitignored) and fill in your real keys.

# Deepgram streaming speech-to-text key (required).
DEEPGRAM_API_KEY=

# Groq LLM key (required — primary answer/fast-path provider).
GROQ_API_KEY=

# Gemini key (optional — automatic failover provider when Groq is unavailable).
GEMINI_API_KEY=

# Write a full JSONL session log to logs/ (true) or disable (false).
DEBUG_DIAGNOSTICS=true

# Pilot privacy: "debug" (default; logs full transcript content for developer
# analysis) or "pilot" (strips candidate transcript/content, keeps timing,
# provider, latency, fallback, and confidence metrics only).
DIAGNOSTICS_PRIVACY=debug